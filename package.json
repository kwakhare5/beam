{
  "name": "beam",
  "version": "0.1.1",
  "private": true,
  "description": "Offline Windows 11 floating pill: media controls, file shelf, timer, calendar.",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build --config vite.preload.mts && vite build",
    "start": "electron .",
    "ui": "vite --config vite.preview.mts",
    "site:dev": "npm --prefix site run dev",
    "site:build": "npm --prefix site run build",
    "generate:icons": "node scripts/generate-icons.mjs",
    "generate:chime": "node scripts/make-chime.mjs",
    "ui:snapshot": "node scripts/ui-snapshot.mjs",
    "ui:check": "node scripts/ui-snapshot.mjs --check",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "lucide-static": "1.62.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
